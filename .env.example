# Copy this file to .env and fill in the values. .env is never committed.

# Label printer location (default: USB printer at /dev/usb/lp0)
LABEL_PRINTER=file:///dev/usb/lp0

# Camera (default /dev/video0). file:references/captures uses test images instead.
# CAMERA_DEVICE=/dev/video0

# Where the app keeps camera settings, saved captures and printed labels (default: ./data)
# DATA_DIR=/data

# DigiKey API (https://developer.digikey.com, create an app to get these)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Inventory web API (chunk 2)
INVENTORY_API_URL=
INVENTORY_API_KEY=
